{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://victoroffgroup.com/contracts/action-intent.v1.schema.json",
  "title": "Action Intent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intentId",
    "actionId",
    "shareholderId",
    "status",
    "submittedAt",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "const": "action-intent.v1"
    },
    "intentId": {
      "type": "string",
      "minLength": 1
    },
    "actionId": {
      "type": "string",
      "minLength": 1
    },
    "shareholderId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["pending", "processing", "completed", "failed", "cancelled"]
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
