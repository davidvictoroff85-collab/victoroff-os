{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://victoroffgroup.com/contracts/governance-resolution.v1.schema.json",
  "title": "Governance Resolution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resolutionId",
    "title",
    "description",
    "proposedBy",
    "status",
    "proposedAt",
    "classification"
  ],
  "properties": {
    "schemaVersion": {
      "const": "governance-resolution.v1"
    },
    "resolutionId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "proposedBy": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["proposed", "voting", "passed", "rejected", "withdrawn"]
    },
    "proposedAt": {
      "type": "string",
      "format": "date-time"
    },
    "passedAt": {
      "type": "string",
      "format": "date-time"
    },
    "classification": {
      "const": "public"
    }
  }
}
