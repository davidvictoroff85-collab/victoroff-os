{
  "name": "victoroff-os",
  "version": "0.2.0",
  "private": true,
  "description": "A public-safe shareholder action center and governed publication system",
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "check:registry": "node scripts/control/validate-program-registry.mjs",
    "check:navigation": "node scripts/control/check-primary-navigation.mjs",
    "check:reconciliation": "node scripts/control/validate-pr-reconciliation.mjs",
    "check:continuation": "node scripts/control/validate-continuation.mjs",
    "cloudflare:deploy": "wrangler deploy",
    "cloudflare:dry-run": "pnpm build && wrangler deploy --dry-run",
    "cloudflare:preview": "wrangler versions upload",
    "dev": "pnpm --filter @victoroff/site dev",
    "lint": "node scripts/lint.mjs",
    "test:control": "node --test tests/control/*.test.mjs",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "build": "pnpm -r --if-present build && node scripts/stage-site.mjs",
    "verify:control": "pnpm check:registry && pnpm check:navigation && pnpm check:reconciliation && pnpm check:continuation && pnpm test:control",
    "verify:scoped": "node scripts/control/verify-scoped.mjs",
    "verify": "pnpm verify:control && pnpm lint && pnpm typecheck && pnpm test && pnpm test:a11y && pnpm test:e2e && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.54.1",
    "@types/node": "24.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "5.8.3",
    "vite": "7.0.6",
    "vitest": "3.2.4",
    "wrangler": "4.104.0"
  }
}
